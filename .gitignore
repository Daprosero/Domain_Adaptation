# macOS
.DS_Store

# Created by proposal-implementation: the target's own environment
__pycache__/
.ipynb_checkpoints/

# The benchmark's own output travels with it: the harness, the notebooks, the record,
# the results, the figures and the weights. None of it touches LFS — .gitattributes
# routes *.pth and these are *.pt.
#
# What stays out is the dataset cache, and only that. It is MNIST, USPS and SVHN
# exactly as torchvision downloads them: somebody else's data, 243 MB of it, that a
# single line fetches again. Carrying a copy in this repository would be
# redistributing it, not recording anything about this work.
.benchmark-data/
