# Local Pi runtime state
.atl/
.venv/
.domain-adaptation-cache/

# macOS
.DS_Store

# Created by proposal-implementation: the target's own environment
__pycache__/
.ipynb_checkpoints/

# What the bounded benchmark produces, not the benchmark itself.
#
# The harness, the notebooks and the record are text and belong in the repository:
# they are what makes the run reproducible, and they are what a later session reads
# to learn where the work stood. What is ignored is regenerable output — the
# checkpoints above all. A gigabyte of weights committed into history doubles the
# working copy and never comes back out of it, and one command reproduces them.
#
# None of this touches LFS: .gitattributes routes *.pth, and these are *.pt.
# Ignored by path throughout, so CREDA/Models and CREDA/Results stay tracked.
MIL-CREDA/Models/Benchmark/
MIL-CREDA/Results/Benchmark/
.benchmark-data/
